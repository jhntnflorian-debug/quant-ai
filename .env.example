# Copia este archivo como .env y rellena solo lo que necesites. Nunca subas .env a Git.

# Modo de ejecución: backtest | paper | live. LIVE está bloqueado por código hasta autorización expresa.
QUANT_AI_MODE=paper

# Binance Spot Testnet (opcional, para paper trading contra el exchange de pruebas).
# Crea las claves en https://testnet.binance.vision/ (inicio de sesión con GitHub).
BINANCE_TESTNET_API_KEY=
BINANCE_TESTNET_API_SECRET=

# Directorio de datos/modelos (en Colab: /content/drive/MyDrive/quant-ai)
QUANT_AI_HOME=
